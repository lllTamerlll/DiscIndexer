<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>Cost_Calculation</RootNamespace>

		<AssemblyName>DiscIndexer</AssemblyName>

		<SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\**\*" />
		<Content Include="Assets\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
	</ItemGroup>

	<PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
	</PropertyGroup>

	<PropertyGroup>
		<PublishReadyToRun>false</PublishReadyToRun>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<Target Name="TrimWinAppSdkLocales" AfterTargets="Publish">
		<ItemGroup>
			<_AllPublishDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir.TrimEnd('\'))'))" />
			<_LocaleDirsToRemove Include="@(_AllPublishDirs)"
				Condition="$([System.IO.File]::Exists('%(Identity)\Microsoft.ui.xaml.dll.mui'))
				           AND !$([System.String]::Copy('%(Filename)').StartsWith('en'))
				           AND !$([System.String]::Copy('%(Filename)').StartsWith('ru'))" />
		</ItemGroup>
		<RemoveDir Directories="@(_LocaleDirsToRemove)" />
		<Message Importance="high" Text="Удалено лишних языковых папок: @(_LocaleDirsToRemove->Count())" />
	</Target>
</Project>
