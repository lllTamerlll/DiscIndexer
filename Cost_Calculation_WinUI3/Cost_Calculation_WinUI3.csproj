<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>Cost_Calculation</RootNamespace>

		<AssemblyName>DiscIndexer</AssemblyName>

		<!-- Интерфейс полностью на русском (строки заданы в коде, ресурсов .resw
		     нет), поэтому оставляем только русские сателлитные ресурсы WinAppSDK.
		     Раньше тут был ещё en, что вводило в заблуждение: английского UI нет. -->
		<SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Assets\**\*" />
		<Content Include="Assets\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Чистая доменная логика (модели, сервисы, реестры, локализация)
		     вынесена в библиотеку без WinUI — см. Cost_Calculation.Core. -->
		<ProjectReference Include="..\Cost_Calculation.Core\Cost_Calculation.Core.csproj" />
	</ItemGroup>

	<PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
	</PropertyGroup>

	<!-- Размер дистрибутива. Тримминг для WinUI 3 не поддерживается безопасно
	     (XAML и WinRT-проекции активно используют рефлексию — обрезка ломает
	     приложение), поэтому PublishTrimmed=false. ReadyToRun только увеличил бы
	     размер ради старта, что противоречит цели держать сборку компактной.
	     Дистрибутив самодостаточный (несёт WinAppSDK), чтобы пользователю не
	     нужно было ставить рантайм отдельно — осознанный размен размера на
	     простоту установки. -->
	<PropertyGroup>
		<PublishReadyToRun>false</PublishReadyToRun>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<Target Name="TrimWinAppSdkLocales" AfterTargets="Publish">
		<ItemGroup>
			<_AllPublishDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir.TrimEnd('\'))'))" />
			<_LocaleDirsToRemove Include="@(_AllPublishDirs)" Condition="$([System.IO.File]::Exists('%(Identity)\Microsoft.ui.xaml.dll.mui'))&#xD;&#xA;				           AND !$([System.String]::Copy('%(Filename)').StartsWith('en'))&#xD;&#xA;				           AND !$([System.String]::Copy('%(Filename)').StartsWith('ru'))" />
		</ItemGroup>
		<RemoveDir Directories="@(_LocaleDirsToRemove)" />
		<Message Importance="high" Text="Удалено лишних языковых папок: @(_LocaleDirsToRemove-&gt;Count())" />
	</Target>
</Project>
