<Page
    x:Class="Cost_Calculation.Pages.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,12,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        Spacing="20" VerticalAlignment="Center">
                <TextBlock x:Name="lblTitle"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>
                <StackPanel x:Name="legendPanel" Orientation="Horizontal"
                            Spacing="10" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="btnAdvice" Grid.Column="1"
                    Content="💡  Совет"
                    Click="BtnAdvice_Click"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushSurface}"
                    Foreground="{StaticResource BrushAccent}"
                    FontWeight="SemiBold"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      x:Name="chartScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      Margin="8,0,8,8">
            <ItemsRepeater x:Name="chartRepeater" Margin="8">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinRowSpacing="16" MinColumnSpacing="16"
                                       ItemsStretch="None"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <StackPanel x:Name="noDataState"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center"/>
            <TextBlock Text="Нет данных для аналитики"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Загрузите JSON на вкладке «Базы данных»"
                       FontSize="14"
                       Foreground="{StaticResource BrushTextSecondary}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Боковая панель совета по фарму -->
        <Grid x:Name="adviceOverlay" Grid.RowSpan="2" Visibility="Collapsed">
            <Rectangle Fill="#99000000" Tapped="AdviceBackdrop_Tapped"/>
            <Border HorizontalAlignment="Right" Width="400"
                    Background="{StaticResource BrushBackground}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,12,10">
                        <StackPanel>
                            <TextBlock Text="💡  Совет по фарму"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock x:Name="lblAdviceSub"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Click="BtnCloseAdvice_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource BrushTextSecondary}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="12,0,12,12"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="adviceContent" Spacing="14"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
