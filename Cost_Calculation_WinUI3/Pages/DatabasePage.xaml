<Page
    x:Class="Cost_Calculation.Pages.DatabasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    >

    <Grid x:Name="outerGrid" Background="Transparent">

        <Grid x:Name="profilesGrid" MaxWidth="900"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="cardBorder0" Grid.Column="0" Grid.Row="0"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtName0" Grid.Column="0"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="16" FontWeight="SemiBold"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 TextChanged="TxtName_TextChanged" Tag="0"/>
                        <Button x:Name="btnSwap0" Grid.Column="1"
                                Content="⇄  Swap" Margin="8,0,8,0"
                                Click="BtnSwap_Click" Tag="0"
                                Background="#FFB300" Foreground="Black"/>
                        <Border x:Name="badgeBorder0" Grid.Column="2"
                                CornerRadius="12" Padding="10,4"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="lblBadge0"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="statsPanel0" Spacing="2">
                        <TextBlock x:Name="lblDiscs0" FontSize="13"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock x:Name="lblDate0" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="btnClipboard0" Grid.Column="0" Grid.Row="0"
                                Content="📋  Clipboard" HorizontalAlignment="Stretch"
                                Click="BtnClipboard_Click" Tag="0"
                                Background="#00BCD4" Foreground="Black"/>
                        <Button x:Name="btnUpload0" Grid.Column="2" Grid.Row="0"
                                Content="⬆  Upload" HorizontalAlignment="Stretch"
                                Click="BtnUpload_Click" Tag="0"
                                Background="#00BCD4" Foreground="Black"/>
                        <Button x:Name="btnDownload0" Grid.Column="0" Grid.Row="2"
                                Content="⬇  Download" HorizontalAlignment="Stretch"
                                Click="BtnDownload_Click" Tag="0"
                                Background="#1565C0" Foreground="White"/>
                        <Button x:Name="btnDelete0" Grid.Column="2" Grid.Row="2"
                                Content="🗑  Delete" HorizontalAlignment="Stretch"
                                Click="BtnDelete_Click" Tag="0"
                                Background="#C62828" Foreground="White"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="cardBorder1" Grid.Column="2" Grid.Row="0"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtName1" Grid.Column="0"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="16" FontWeight="SemiBold"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 TextChanged="TxtName_TextChanged" Tag="1"/>
                        <Button x:Name="btnSwap1" Grid.Column="1"
                                Content="⇄  Swap" Margin="8,0,8,0"
                                Click="BtnSwap_Click" Tag="1"
                                Background="#FFB300" Foreground="Black"/>
                        <Border x:Name="badgeBorder1" Grid.Column="2"
                                CornerRadius="12" Padding="10,4"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="lblBadge1"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="statsPanel1" Spacing="2">
                        <TextBlock x:Name="lblDiscs1" FontSize="13"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock x:Name="lblDate1" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="btnClipboard1" Grid.Column="0" Grid.Row="0"
                                Content="📋  Clipboard" HorizontalAlignment="Stretch"
                                Click="BtnClipboard_Click" Tag="1"
                                Background="#00BCD4" Foreground="Black"/>
                        <Button x:Name="btnUpload1" Grid.Column="2" Grid.Row="0"
                                Content="⬆  Upload" HorizontalAlignment="Stretch"
                                Click="BtnUpload_Click" Tag="1"
                                Background="#00BCD4" Foreground="Black"/>
                        <Button x:Name="btnDownload1" Grid.Column="0" Grid.Row="2"
                                Content="⬇  Download" HorizontalAlignment="Stretch"
                                Click="BtnDownload_Click" Tag="1"
                                Background="#1565C0" Foreground="White"/>
                        <Button x:Name="btnDelete1" Grid.Column="2" Grid.Row="2"
                                Content="🗑  Delete" HorizontalAlignment="Stretch"
                                Click="BtnDelete_Click" Tag="1"
                                Background="#C62828" Foreground="White"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="cardBorder2" Grid.Column="0" Grid.Row="2"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtName2" Grid.Column="0"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="16" FontWeight="SemiBold"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 TextChanged="TxtName_TextChanged" Tag="2"/>
                        <Button x:Name="btnSwap2" Grid.Column="1"
                                Content="⇄  Swap" Margin="8,0,8,0"
                                Click="BtnSwap_Click" Tag="2"
                                Background="#FFB300" Foreground="Black"/>
                        <Border x:Name="badgeBorder2" Grid.Column="2"
                                CornerRadius="12" Padding="10,4"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="lblBadge2"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="statsPanel2" Spacing="2">
                        <TextBlock x:Name="lblDiscs2" FontSize="13"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock x:Name="lblDate2" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="btnClipboard2" Grid.Column="0" Grid.Row="0"
                                Content="📋  Clipboard" HorizontalAlignment="Stretch"
                                Click="BtnClipboard_Click" Tag="2"
                                Background="#00BCD4" Foreground="Black"/>
                        <Button x:Name="btnUpload2" Grid.Column="2" Grid.Row="0"
                                Content="⬆  Upload" HorizontalAlignment="Stretch"
                                Click="BtnUpload_Click" Tag="2"
                                Background="#00BCD4" Foreground="Black"/>
                        <Button x:Name="btnDownload2" Grid.Column="0" Grid.Row="2"
                                Content="⬇  Download" HorizontalAlignment="Stretch"
                                Click="BtnDownload_Click" Tag="2"
                                Background="#1565C0" Foreground="White"/>
                        <Button x:Name="btnDelete2" Grid.Column="2" Grid.Row="2"
                                Content="🗑  Delete" HorizontalAlignment="Stretch"
                                Click="BtnDelete_Click" Tag="2"
                                Background="#C62828" Foreground="White"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="cardBorder3" Grid.Column="2" Grid.Row="2"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtName3" Grid.Column="0"
                                 Background="Transparent" BorderThickness="0"
                                 FontSize="16" FontWeight="SemiBold"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 TextChanged="TxtName_TextChanged" Tag="3"/>
                        <Button x:Name="btnSwap3" Grid.Column="1"
                                Content="⇄  Swap" Margin="8,0,8,0"
                                Click="BtnSwap_Click" Tag="3"
                                Background="#FFB300" Foreground="Black"/>
                        <Border x:Name="badgeBorder3" Grid.Column="2"
                                CornerRadius="12" Padding="10,4"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="lblBadge3"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="statsPanel3" Spacing="2">
                        <TextBlock x:Name="lblDiscs3" FontSize="13"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock x:Name="lblDate3" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="btnClipboard3" Grid.Column="0" Grid.Row="0"
                                Content="📋  Clipboard" HorizontalAlignment="Stretch"
                                Click="BtnClipboard_Click" Tag="3"
                                Background="#00BCD4" Foreground="Black"/>
                        <Button x:Name="btnUpload3" Grid.Column="2" Grid.Row="0"
                                Content="⬆  Upload" HorizontalAlignment="Stretch"
                                Click="BtnUpload_Click" Tag="3"
                                Background="#00BCD4" Foreground="Black"/>
                        <Button x:Name="btnDownload3" Grid.Column="0" Grid.Row="2"
                                Content="⬇  Download" HorizontalAlignment="Stretch"
                                Click="BtnDownload_Click" Tag="3"
                                Background="#1565C0" Foreground="White"/>
                        <Button x:Name="btnDelete3" Grid.Column="2" Grid.Row="2"
                                Content="🗑  Delete" HorizontalAlignment="Stretch"
                                Click="BtnDelete_Click" Tag="3"
                                Background="#C62828" Foreground="White"/>
                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Page>
