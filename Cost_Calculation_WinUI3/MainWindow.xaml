<Window
    x:Class="Cost_Calculation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Cost_Calculation.Pages"
    Title="Disc Indexer">

    <Grid x:Name="rootGrid" Background="#1c1e1d">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#1c1e1d">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <Image Source="ms-appx:///Assets/icon.png"
                       Width="16" Height="16" Margin="0,0,8,0"
                       VerticalAlignment="Center"/>
                <TextBlock Text="Disc Indexer"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TabView Grid.Row="1"
                 x:Name="mainTabView"
                 IsAddTabButtonVisible="False"
                 TabWidthMode="Equal"
                 Background="#171918"
                 SelectionChanged="MainTabView_SelectionChanged">

            <TabView.TabItems>

                <TabViewItem Header="📦  Инвентарь" IsClosable="False">
                    <pages:InventoryPage x:Name="inventoryPage"/>
                </TabViewItem>

                <TabViewItem Header="🗄  Базы данных" IsClosable="False">
                    <pages:DatabasePage x:Name="databasePage"
                                        ProfileSwapped="DatabasePage_ProfileSwapped"/>
                </TabViewItem>

            </TabView.TabItems>
        </TabView>

    </Grid>
</Window>
