<UserControl
    x:Class="Cost_Calculation.Controls.FilterRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cost_Calculation.Controls">

    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
        <ComboBox x:Name="cboStat" Width="130" Height="32"
                  Background="{StaticResource BrushSurface}"
                  Foreground="{StaticResource BrushTextPrimary}"
                  SelectionChanged="CboStat_SelectionChanged"/>
        <TextBlock Text="мин." FontSize="11"
                   Foreground="{StaticResource BrushTextSecondary}"
                   VerticalAlignment="Center" Width="30"/>
        <NumberBox x:Name="nudMin" Minimum="0" Maximum="9" Value="1"
                   SpinButtonPlacementMode="Compact" Width="75"
                   ValueChanged="Nud_ValueChanged"/>
        <TextBlock Text="макс." FontSize="11"
                   Foreground="{StaticResource BrushTextSecondary}"
                   VerticalAlignment="Center" Width="38"/>
        <NumberBox x:Name="nudMax" Minimum="0" Maximum="9" Value="9"
                   SpinButtonPlacementMode="Compact" Width="75"
                   ValueChanged="Nud_ValueChanged"/>
        <Button Content="×" Width="28" Height="28" Padding="0"
                Background="Transparent"
                Foreground="{StaticResource BrushTextSecondary}"
                BorderThickness="0" Click="BtnRemove_Click"/>
    </StackPanel>
</UserControl>