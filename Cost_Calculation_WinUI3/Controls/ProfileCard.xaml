<UserControl
    x:Class="Cost_Calculation.Controls.ProfileCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="cardBorder"
            Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushSeparator}"
            BorderThickness="1" CornerRadius="8" Padding="20">
        <StackPanel Spacing="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtName" Grid.Column="0"
                         Background="Transparent" BorderThickness="0"
                         FontSize="16" FontWeight="SemiBold"
                         Foreground="{StaticResource BrushTextPrimary}"
                         TextChanged="TxtName_TextChanged"/>
                <Button x:Name="btnSwap" Grid.Column="1"
                        Content="⇄  Swap" Margin="8,0,8,0"
                        Click="BtnSwap_Click"
                        Background="#FFB300" Foreground="Black"/>
                <Border x:Name="badgeBorder" Grid.Column="2"
                        CornerRadius="12" Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="lblBadge"
                               FontSize="12" FontWeight="Bold"
                               Foreground="White"/>
                </Border>
            </Grid>

            <StackPanel Spacing="2">
                <TextBlock x:Name="lblDiscs" FontSize="13"
                           Foreground="{StaticResource BrushTextSecondary}"/>
                <TextBlock x:Name="lblDate" FontSize="12"
                           Foreground="{StaticResource BrushTextSecondary}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button x:Name="btnClipboard" Grid.Column="0" Grid.Row="0"
                        Content="📋  Clipboard" HorizontalAlignment="Stretch"
                        Click="BtnClipboard_Click"
                        Background="#00BCD4" Foreground="Black"/>
                <Button x:Name="btnUpload" Grid.Column="2" Grid.Row="0"
                        Content="⬆  Upload" HorizontalAlignment="Stretch"
                        Click="BtnUpload_Click"
                        Background="#00BCD4" Foreground="Black"/>
                <Button x:Name="btnDownload" Grid.Column="0" Grid.Row="2"
                        Content="⬇  Download" HorizontalAlignment="Stretch"
                        Click="BtnDownload_Click"
                        Background="#1565C0" Foreground="White"/>
                <Button x:Name="btnDelete" Grid.Column="2" Grid.Row="2"
                        Content="🗑  Delete" HorizontalAlignment="Stretch"
                        Click="BtnDelete_Click"
                        Background="#C62828" Foreground="White"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
